{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es6",
    "types": ["reflect-metadata", "jest"],
    "module": "commonjs",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "out",
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "strictNullChecks": true,
    "resolveJsonModule": false, // DO NOT CHANGE
    "paths": {
      "@app/*": ["./src/*"],
    },
  },
  "include": ["src/**/*"],
  "exclude": ["tests/**/*"]
}
